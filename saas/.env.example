# SpirCore SaaS configuration (copy to .env; never commit real secrets)
SAAS_ADMIN_TOKEN=change-me-to-a-long-random-string
SAAS_DB=saas.db

# --- Client portal (/portal, /me) ---
# Mode B: the master channel (= master's license key) subscribers follow.
SAAS_MASTER_CHANNEL=
# Mode A: the control-dashboard URL shown to self-managed clients.
SAAS_DASHBOARD_URL=http://127.0.0.1:8000/dashboard

# --- Stripe (when wiring real billing) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

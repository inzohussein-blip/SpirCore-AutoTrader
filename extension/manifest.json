{
  "manifest_version": 3,
  "name": "SpirCore Bridge",
  "version": "1.1.0",
  "description": "Relay TradingView alerts to MT5 for XAUUSD - via the local Python bridge (desktop MT5) OR directly on the MT5 Web terminal (no app needed).",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://trade.mql5.com/*",
    "*://*.mql5.com/*",
    "*://web.metatrader5.com/*",
    "*://*.metatrader5.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpirCore Bridge"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://trade.mql5.com/*",
        "*://*.mql5.com/*",
        "*://web.metatrader5.com/*",
        "*://*.metatrader5.com/*"
      ],
      "js": ["mt5web.js"],
      "run_at": "document_idle"
    }
  ]
}

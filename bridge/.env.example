# SpirCore-AutoTrader :: Python Bridge configuration
# Copy to ".env" and fill in. NEVER commit the real .env.

# --- Server ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
BRIDGE_AUTH_TOKEN=change-me-to-a-long-random-string

# --- MetaTrader 5 (leave login blank to use the already-logged-in terminal) ---
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Trading defaults (mirror the EA) ---
SYMBOL=XAUUSD
DEFAULT_LOT=0.10
MAGIC=990011
DEVIATION_PTS=20

# --- Risk / safety ---
MAX_SPREAD_PTS=30
SL_POINTS=300
TP_POINTS=600
MODIFY_RETRIES=3
MAX_POSITIONS=1
# Risk guard (0 disables): halt trading after this daily loss %, and cap trades/day
MAX_DAILY_LOSS_PCT=5.0
MAX_TRADES_PER_DAY=10
# Total open-lots cap across all EA positions (0 = unlimited)
MAX_TOTAL_LOTS=0
# Trading-session kill-switch (local time). end<start wraps midnight (e.g. 22..6)
USE_SESSION_FILTER=false
SESSION_START_HOUR=0
SESSION_END_HOUR=24

# --- SaaS performance push (optional; both required to enable) ---
SAAS_URL=
SAAS_LICENSE_KEY=

# --- Notifications (all optional; leave blank to disable a channel) ---
# Telegram: create a bot via @BotFather, get the token; chat id via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Email (SMTP), e.g. Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=
EMAIL_TO=

# --- Position management (break-even + trailing), applied by a background loop ---
USE_BREAK_EVEN=true
BE_TRIGGER_PTS=300
BE_LOCK_PTS=20
USE_TRAILING=true
TRAIL_START_PTS=400
TRAIL_DIST_PTS=250
TRAIL_STEP_PTS=30
MANAGE_INTERVAL_SEC=2.0

# --- Python <-> EA files (put all three in the terminal's MQL5/Files folder) ---
# e.g. C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\<hash>\MQL5\Files\
LEVELS_FILE=spircore_levels.csv
COMMANDS_FILE=spircore_commands.csv
JOURNAL_FILE=spircore_journal.csv
STATUS_FILE=spircore_status.csv
